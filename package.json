    "aws4fetch": "^1.0.20",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-static": "^0.544.0",
    "mammoth": "^1.9.0",
    "multer": "^2.0.2",
    "pdf-parse": "1.1.1",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "wrangler": "^4.163.0"
  }
