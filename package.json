{
  "name": "doc-to-video-studio",
  "version": "1.0.0",
  "description": "Turn a document or a description into a narrated, animated explainer video (MP4).",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "sample": "node scripts/render-sample.js",
    "deploy": "wrangler deploy"
