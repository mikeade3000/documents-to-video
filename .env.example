# --- Required: writes the storyboard and narration script -------------------
# Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=

# --- Voice-over: set ONE of these (without one, videos are silent + captions)
# OpenAI text-to-speech (https://platform.openai.com) - good quality, low cost
OPENAI_API_KEY=
# ElevenLabs (https://elevenlabs.io) - most natural voices, custom/cloned voices
ELEVENLABS_API_KEY=
# Voices offered when ElevenLabs is used, as Label:voiceId pairs from your voice library
# ELEVENLABS_VOICES=Rachel:21m00Tcm4TlvDq8ikWAM,Adam:pNInz6obpgDQGcFmaJgB
# Force a provider when both keys are set: openai | elevenlabs | none
# TTS_PROVIDER=

# --- Payments (Flutterwave): leave empty to make downloads free --------------
# Visitors create and preview for free, then pay to download the MP4.
# Keys: Flutterwave dashboard -> Settings -> API keys (use the TEST keys first)
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
# Optional: the "secret hash" from Settings -> Webhooks; webhook URL is https://YOUR-SITE/api/pay/webhook
FLW_WEBHOOK_HASH=
PRICE_DOWNLOAD=1500
CURRENCY=NGN
SITE_NAME=Doc-to-Video Studio
# Days a paid video stays downloadable
PAID_KEEP_DAYS=30

# --- Optional ----------------------------------------------------------------
PORT=3000
# Visitors must enter this code before they can generate (protects your API spend)
ACCESS_CODE=
# Videos one visitor (IP address) may make per hour
JOBS_PER_HOUR=6
# Where uploads and finished videos are stored, and how long they are kept
DATA_DIR=./data
KEEP_HOURS=24
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=high
# RENDER_WORKERS=3
# CONCURRENT_JOBS=1
